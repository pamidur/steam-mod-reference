<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="$(MSBuildThisFileDirectory)../../build/SteamModReference.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>

    <!-- RimWorld config -->
    <SteamModAppId>294100</SteamModAppId>
    <SteamModDefaultAssemblies>1.6/Assemblies/*.*;Assemblies/*.*</SteamModDefaultAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <SteamModReference Include="2872901762" />
  </ItemGroup>

  <ItemGroup>    
    <ProjectReference Include="../../src/SteamModReference.csproj" />
    <ProjectReference Include="../FakeGame/Assembly-CSharp.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <!-- required for debug only -->
    <_SteamModTaskLocation>$(MSBuildThisFileDirectory)../../artifacts/bin/SteamModReference/$(Configuration.ToLowerInvariant())/Pamidur.SteamModReference.Tasks.dll</_SteamModTaskLocation>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>  

  <Import Project="$(MSBuildThisFileDirectory)../../build/SteamModReference.targets" />

</Project>