<Project>

  <!-- Support for donnet VSCode and Ryder via net10 and full VS via TaskHostFactory. User machine
  still required to have net10 sdk -->

  <UsingTask
    TaskName="Pamidur.SteamModReference.Tasks.ResolveModReferencesTask"
    AssemblyFile="$(_SteamModTaskLocation)"
    Runtime="NET" TaskFactory="TaskHostFactory"
    Condition="'$(MSBuildRuntimeType)' == 'Full'"
  />
  <UsingTask
    TaskName="Pamidur.SteamModReference.Tasks.ResolveModReferencesTask"
    AssemblyFile="$(_SteamModTaskLocation)"
    Runtime="NET"
    Condition="'$(MSBuildRuntimeType)' == 'Core'" />

  <PropertyGroup>
    <ResolveAssemblyReferencesDependsOn>
      ResolveSteamModReferences
      $(ResolveAssemblyReferencesDependsOn);
    </ResolveAssemblyReferencesDependsOn>
    <CopyFilesToOutputDirectoryDependsOn>
      $(CopyFilesToOutputDirectoryDependsOn);
      ResolveSteamModReferences
    </CopyFilesToOutputDirectoryDependsOn>
  </PropertyGroup>

  <Target Name="ResolveSteamModReferences" BeforeTargets="ResolveAssemblyReferences;CopyFilesToOutputDirectory">

    <!--
      TODO (incrementality): add Inputs/Outputs here keyed on the script file 
      so MSBuild itself can skip this whole target when @(SteamModReference) hasn't changed, e.g.:
        Inputs="$(MSBuildProjectFile);$(SteamModIntermediateDir)manifest.json"
        Outputs="$(SteamModIntermediateDir)manifest.json"
    -->

    <ResolveModReferencesTask
      Condition="'@(SteamModReference)' != ''"
      Mods="@(SteamModReference)"
      AppId="$(SteamModAppId)"
      IntermediateDir="$(SteamModIntermediateDir)"
      DefaultAssembliesPatterns="$(SteamModDefaultAssemblies)"
      ExistingReferences="@(Reference)">
      <Output TaskParameter="ResolvedAssemblies" ItemName="_SteamModResolvedReference" />
    </ResolveModReferencesTask>

    <ItemGroup>
      <Reference Include="@(_SteamModResolvedReference)" />
    </ItemGroup>

  </Target>

  <Target Name="CleanSteamModReferences" AfterTargets="Clean">

    <ItemGroup>
      <_SteamModCleanDirs
        Include="$(SteamModIntermediateDir)steam\steamapps\workshop"
        Condition="Exists('$(SteamModIntermediateDir)steam\steamapps\workshop')" />
      <_SteamModCleanDirs
        Include="$(SteamModIntermediateDir)steamcmd"
        Condition="'$(SteamModCleanRemovesToolCache)' == 'true' and Exists('$(SteamModIntermediateDir)steamcmd')" />
    </ItemGroup>

    <RemoveDir Directories="@(_SteamModCleanDirs)" Condition="'@(_SteamModCleanDirs)' != ''" />

    <Delete
      Files="$(SteamModIntermediateDir)manifest.json"
      Condition="Exists('$(SteamModIntermediateDir)manifest.json')" />

    <Message
      Importance="Normal"
      Text="SMR: cleared staged workshop mod content under $(SteamModIntermediateDir)steam\steamapps\workshop." />

  </Target>

</Project>